FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/simulator ./cmd/simulator

FROM alpine:3.20
RUN adduser -D -u 10001 appuser
COPY --from=build /out/simulator /usr/local/bin/simulator
USER appuser
ENTRYPOINT ["simulator"]